{
  "uid": "aiops-caption-monitor",
  "title": "DA3408 | AI Image Captioning Observability",
  "description": "CPU-only BLIP inference monitoring with Prometheus and Node Exporter",
  "tags": [
    "DA3408",
    "AIOps",
    "CPU",
    "Prometheus"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 2,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m"
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "01 | Application Health",
      "description": "1 = Prometheus can reach application metrics; 0 = unavailable",
      "datasource": {
        "type": "prometheus",
        "uid": "aiops-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job='ai_captioning'}",
          "legendFormat": "Application UP",
          "datasource": {
            "type": "prometheus",
            "uid": "aiops-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "02 | Total Images Processed",
      "description": "Total successful image inferences since metric counter reset",
      "datasource": {
        "type": "prometheus",
        "uid": "aiops-prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(caption_images_processed_total)",
          "legendFormat": "Images",
          "datasource": {
            "type": "prometheus",
            "uid": "aiops-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "03 | Model Loaded",
      "description": "1 indicates the BLIP model has been initialized",
      "datasource": {
        "type": "prometheus",
        "uid": "aiops-prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 0,
        "w": 8,
        "h": 5
      },
      "targets": [
        {
          "refId": "A",
          "expr": "caption_model_loaded",
          "legendFormat": "Loaded",
          "datasource": {
            "type": "prometheus",
            "uid": "aiops-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false
          },
          "mappings": []
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "auto",
        "textMode": "auto",
        "colorMode": "value"
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "04 | Image Throughput (images/sec)",
      "description": "Successful images per second, averaged over one minute",
      "datasource": {
        "type": "prometheus",
        "uid": "aiops-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(mode)(rate(caption_images_processed_total[1m]))",
          "legendFormat": "{{mode}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aiops-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false
          },
          "mappings": [],
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "05 | Average Inference Latency (seconds)",
      "description": "Mean CPU inference duration per image; blank when no recent observations",
      "datasource": {
        "type": "prometheus",
        "uid": "aiops-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 5,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(mode)(rate(caption_inference_seconds_sum[5m]))\n/\nsum by(mode)(rate(caption_inference_seconds_count[5m]))",
          "legendFormat": "{{mode}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aiops-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false
          },
          "mappings": [],
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "06 | P95 Inference Latency (seconds)",
      "description": "Estimated 95th percentile per-image inference latency",
      "datasource": {
        "type": "prometheus",
        "uid": "aiops-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(\n0.95,\nsum by(le,mode)(rate(caption_inference_seconds_bucket[5m]))\n)",
          "legendFormat": "{{mode}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aiops-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false
          },
          "mappings": [],
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "07 | Request Outcomes (jobs/sec)",
      "description": "Successful and failed captioning jobs per second",
      "datasource": {
        "type": "prometheus",
        "uid": "aiops-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 13,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(mode,status)(rate(caption_requests_total[5m]))",
          "legendFormat": "{{mode}} / {{status}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aiops-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false
          },
          "mappings": [],
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "08 | Active Processing Jobs",
      "description": "Currently running single or bulk processing jobs",
      "datasource": {
        "type": "prometheus",
        "uid": "aiops-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(mode)(caption_active_requests)",
          "legendFormat": "{{mode}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aiops-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false
          },
          "mappings": [],
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "09 | Average Job Duration (seconds)",
      "description": "Average complete job duration, including image processing",
      "datasource": {
        "type": "prometheus",
        "uid": "aiops-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 21,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(mode)(rate(caption_job_duration_seconds_sum[5m]))\n/\nsum by(mode)(rate(caption_job_duration_seconds_count[5m]))",
          "legendFormat": "{{mode}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aiops-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false
          },
          "mappings": [],
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "10 | Error Events (per minute)",
      "description": "Average error events per minute across the last five minutes",
      "datasource": {
        "type": "prometheus",
        "uid": "aiops-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(mode,error_type)(increase(caption_errors_total[5m])) / 5",
          "legendFormat": "{{mode}} / {{error_type}}",
          "datasource": {
            "type": "prometheus",
            "uid": "aiops-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false
          },
          "mappings": [],
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "11 | Cumulative Batch Size Distribution",
      "description": "Cumulative batch-size bucket observation rates. Each bucket counts jobs with batch size less than or equal to its upper bound. Values are jobs per second.",
      "datasource": {
        "type": "prometheus",
        "uid": "aiops-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 29,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(le)(rate(caption_batch_size_bucket[5m]))",
          "legendFormat": "Up to {{le}} images",
          "datasource": {
            "type": "prometheus",
            "uid": "aiops-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false
          },
          "mappings": [],
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "12 | CPU Utilization (%)",
      "description": "Busy CPU capacity across all logical processors",
      "datasource": {
        "type": "prometheus",
        "uid": "aiops-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (\n1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m]))\n)",
          "legendFormat": "CPU usage",
          "datasource": {
            "type": "prometheus",
            "uid": "aiops-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false
          },
          "mappings": [],
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "13 | RAM Utilization (%)",
      "description": "Estimated memory utilization using MemAvailable",
      "datasource": {
        "type": "prometheus",
        "uid": "aiops-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (\n1 - node_memory_MemAvailable_bytes\n/ node_memory_MemTotal_bytes\n)",
          "legendFormat": "RAM used",
          "datasource": {
            "type": "prometheus",
            "uid": "aiops-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false
          },
          "mappings": [],
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 14,
      "type": "timeseries",
      "title": "14 | CPU Utilization vs Bulk Throughput",
      "description": "CPU utilization (%) on the left axis and bulk image throughput (images/sec) on the right axis. Both use real, unscaled measurements.",
      "datasource": {
        "type": "prometheus",
        "uid": "aiops-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 45,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (\n1 - avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m]))\n)",
          "legendFormat": "CPU %",
          "datasource": {
            "type": "prometheus",
            "uid": "aiops-prometheus"
          }
        },
        {
          "refId": "B",
          "expr": "sum(rate(caption_images_processed_total{mode=\"bulk\"}[1m]))",
          "legendFormat": "Bulk images/sec",
          "datasource": {
            "type": "prometheus",
            "uid": "aiops-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "auto",
            "spanNulls": false,
            "axisLabel": "CPU utilization (%)",
            "axisPlacement": "left"
          },
          "mappings": [],
          "min": 0
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ops"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              },
              {
                "id": "custom.axisLabel",
                "value": "Images/sec"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 15,
      "type": "timeseries",
      "title": "15 | Root Disk Utilization (%)",
      "description": "Percentage used on the Ubuntu root filesystem",
      "datasource": {
        "type": "prometheus",
        "uid": "aiops-prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 45,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (\n1 - node_filesystem_avail_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}\n/ node_filesystem_size_bytes{mountpoint=\"/\",fstype!~\"tmpfs|overlay\"}\n)",
          "legendFormat": "Root filesystem",
          "datasource": {
            "type": "prometheus",
            "uid": "aiops-prometheus"
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
